{
  "branches": [
    "+([0-9])?(.{+([0-9]),x}).x",
    "main",
    {
      "name": "next",
      "prerelease": "rc",
      "channel": "next"
    }
  ],
  "plugins": [
    [
      "@semantic-release/commit-analyzer",
      {
        "preset": "conventionalcommits"
      }
    ],
    [
      "@google/semantic-release-replace-plugin",
      {
        "replacements": [
          {
            "countMatches": true,
            "files": [
              "pysnmp/__init__.py"
            ],
            "from": "^__version__ ?=.*",
            "results": [
              {
                "file": "pysnmp/__init__.py",
                "hasChanged": true,
                "numMatches": 1,
                "numReplacements": 1
              }
            ],
            "to": "__version__ = \"${nextRelease.version}\""
          },
          {
            "countMatches": true,
            "files": [
              "pyproject.toml"
            ],
            "from": "^version ?=.*",
            "results": [
              {
                "file": "pyproject.toml",
                "hasChanged": true,
                "numMatches": 1,
                "numReplacements": 1
              }
            ],
            "to": "version = \"${nextRelease.version}\""
          }
        ]
      }
    ],
    [
      "@semantic-release/release-notes-generator",
      {
        "preset": "conventionalcommits"
      }
    ],
    [
      "@semantic-release/changelog",
      {
        "changelogFile": "CHANGELOG.md",
        "changelogTitle": "# Changelog\n\nGenerated from the commit history at release time. The narrative history\nthrough 5.x is in [CHANGES.md](https://github.com/pysnmp/pysnmp/blob/main/CHANGES.md)."
      }
    ],
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "./.github/workflows/sr-prepare.sh ${nextRelease.version}",
        "shell": "bash"
      }
    ],
    [
      "@semantic-release/git",
      {
        "assets": [
          "CHANGELOG.md",
          "NOTICE",
          "pyproject.toml",
          "pysnmp/__init__.py",
          "uv.lock"
        ],
        "message": "chore(release): ${nextRelease.version}\n\n${nextRelease.notes}"
      }
    ],
    [
      "@semantic-release/github",
      {
        "assets": [
          "NOTICE",
          "pyproject.toml"
        ]
      }
    ]
  ]
}
